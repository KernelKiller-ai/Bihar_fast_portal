{
  "rewrites": [
    {
      "source": "/post/:slug",
      "destination": "/api/post-seo?slug=:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "https://bihar-fast-portal.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets/|favicon.ico|robots.txt|sitemap.*\\.xml|.*\\.(?:css|js|png|jpg|jpeg|svg|webp|ico|json|woff2?)).*)",
      "destination": "/index.html"
    }
  ]
}